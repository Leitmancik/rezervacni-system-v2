# Zkopírujte stejné hodnoty jako u původní aplikace.
# Skutečný secrets.toml nepatří do GitHubu.
sheet_id = "ID_SPOLECNE_GOOGLE_TABULKY"

[gcp_service_account]
type = "service_account"
project_id = "GOOGLE_PROJECT_ID"
private_key_id = "KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "SERVICE_ACCOUNT_EMAIL"
client_id = "CLIENT_ID"
token_uri = "https://oauth2.googleapis.com/token"

# Aktivovat až po nasazení integrations/cleaning.gs a ověření domény v Resendu.
[cleaning_mail]
enabled = false
url = "https://script.google.com/macros/s/DEPLOYMENT_ID/exec"
secret = "STEJNE_API_SECRET_JAKO_V_APPS_SCRIPT_MIN_32_ZNAKU"
